        "@types/node": "^25.9.7",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.1",
        "tsx": "^4.23.13",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.57.2"
    },
    "dependencies": {
