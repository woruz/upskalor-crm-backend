    "/quotations": {
      "get": {
        "tags": ["Quotations"],
        "summary": "List Quotations",
        "description": "Returns a paginated list of solar project quotations with search, filters, and customer lead details.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Searches quote number and lead customer name" },
          { "name": "leadId", "in": "query", "schema": { "type": "string", "format": "uuid" }, "description": "Filter quotations for a specific lead" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "SENT", "ACCEPTED", "REJECTED", "EXPIRED"] } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["createdAt", "validityDate", "quoteNumber", "systemSizeKw", "grandTotal"], "default": "createdAt" } },
          { "name": "direction", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated quotations list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Quotation" } },
                    "pagination": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "tags": ["Quotations"],
        "summary": "Create Quotation",
        "description": "Creates a quotation with basic details, payment split percentages, line items, and financial summary auto-calculations. Also logs activity on the associated lead.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuotationInput" },
              "example": {
                "leadId": "123e4567-e89b-12d3-a456-426614174000",
                "quoteNumber": "QT-2026-0005",
                "systemSizeKw": 5.5,
                "validityDate": "2026-10-02T00:00:00.000Z",
                "paymentTermsTemplate": "Custom Terms",
                "advancePercentage": 30,
                "deliveryPercentage": 50,
                "commissioningPercentage": 20,
                "stateSubsidyCapOverride": 15000,
                "centralSubsidy": 78000,
                "stateSubsidy": 0,
                "status": "DRAFT",
                "notes": "Custom installation requirements",
                "items": [
                  {
                    "name": "Solar Panel 540W",
                    "brand": "Tata Power Solar",
                    "quantity": 10,
                    "rate": 18000,
                    "gstRate": 12
                  },
                  {
                    "name": "Solar Inverter 5kW",
                    "brand": "Growatt",
                    "quantity": 1,
                    "rate": 45000,
                    "gstRate": 18
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Quotation created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "data": { "$ref": "#/components/schemas/Quotation" } }
                }
              }
            }
          },
          "400": { "description": "Validation error or invalid lead ID", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
